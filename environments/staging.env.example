ENVIRONMENT=staging
DATABASE_URL=postgresql://STAGING_DATABASE_ONLY
SECRET_KEY=GENERATE_A_UNIQUE_STAGING_SECRET
DATA_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_STAGING_DATA_KEY
