ENVIRONMENT=production
DATABASE_URL=postgresql://PRODUCTION_DATABASE_ONLY
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_32_PLUS_CHARACTER_KEY
CORS_ORIGINS=https://valorbuddy.com,https://www.valorbuddy.com,capacitor://localhost,https://localhost,http://localhost
ALLOWED_HOSTS=valorbuddy.onrender.com,valorbuddy.com,www.valorbuddy.com
SECURITY_ENFORCE_CONFIG=true
FORCE_HTTPS=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_REQUEST_BODY_BYTES=10485760
REQUEST_LIMIT_PER_MINUTE=300
AUTH_LIMIT_PER_15_MINUTES=10
VA_FACILITIES_BASE_URL=https://api.va.gov/services/va_facilities/v1
REMINDER_DISPATCHER_ENABLED=true
ADMIN_MFA_REQUIRED=true
PASSWORD_RESET_BASE_URL=https://valorbuddy.com
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_FROM_EMAIL=ValorBuddy Security <security@valorbuddy.com>
AUDIT_RETENTION_DAYS=365
