# Local development only. Copy to .env; never commit the populated file.
ENVIRONMENT=development
DATABASE_URL=postgresql://...
SECRET_KEY=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-a-different-long-random-value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SECURITY_ENFORCE_CONFIG=false
FORCE_HTTPS=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_REQUEST_BODY_BYTES=10485760
REQUEST_LIMIT_PER_MINUTE=300
AUTH_LIMIT_PER_15_MINUTES=10
GOOGLE_API_KEY=replace-with-google-api-key
# Optional backward-compatible alias; do not set both unless desired.
# GEMINI_API_KEY=replace-with-the-same-google-api-key
GEMINI_MODEL=gemini-3.6-flash
# Optional. If omitted, the planner uses GEMINI_MODEL automatically.
GEMINI_PLANNER_MODEL=gemini-3.6-flash
ENABLE_GOOGLE_SEARCH_GROUNDING=true
GOOGLE_PLACES_API_KEY=replace-with-google-maps-key
# Official VA Lighthouse Facilities API. Sandbox is the safe default.
VA_FACILITIES_API_KEY=replace-with-va-lighthouse-key
VA_FACILITIES_BASE_URL=https://sandbox-api.va.gov/services/va_facilities/v1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Frontend
VITE_API_BASE_URL=https://valorbuddy.onrender.com

# Production admin account (set both in Render)
ADMIN_EMAIL=eugene.ebem@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_MFA_REQUIRED=true
PASSWORD_RESET_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_FROM_EMAIL=ValorBuddy Security <security@valorbuddy.com>
AUDIT_RETENTION_DAYS=365

# Reminder reliability (optional server-side email fallback)
# Set in Render for reminders to reach users even when the web app/browser is closed.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=ValorBuddy <reminders@valorbuddy.com>
REMINDER_POLL_SECONDS=30
REMINDER_DISPATCHER_ENABLED=true
